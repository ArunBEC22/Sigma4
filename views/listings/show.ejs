<% layout("/layouts/boilerplate.ejs") %>

<style>
/* GENERAL LAYOUT */
section {
  margin-top: 3rem;
}
.section-header {
  text-align: center !important;
  margin: 0 auto 1.5rem auto;
  font-size: 26px;
  font-weight: 600;
  border-bottom: 2px solid #ddd;
  padding-bottom: 0.5rem;
  width: fit-content;
}
@media (max-width: 576px) {
  .section-header {
    font-size: 22px;
    width: 100%;
  }
}
.details-booking-container {
  display: flex;
  gap: 2rem;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 3rem;
}
.listing-card, .payment-card {
  flex: 1 1 45%;
  max-width: 48%;
}

/* Stack layout only below 500px */
@media (max-width: 500px) {
  .listing-card, .payment-card {
    max-width: 100%;
    flex: 1 1 100%;
  }
  .details-booking-container {
    flex-direction: column;
    align-items: center;
  }
}

/* For review layout fixes */
@media (max-width: 576px) {
  .ms-3 {
    margin-left: 0 !important;
  }
  .col-md-5 {
    width: 100% !important;
  }
  .card-text, .card-title {
    font-size: 1rem;
    text-align: left;
  }
}

/* LISTING CARD */
.listing-card {
  border-radius: 15px;
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.listing-card:hover {
  transform: scale(1.03);
  box-shadow: 0 8px 16px rgba(0,0,0,0.2);
}
.show-img {
  border-radius: 15px 15px 0 0;
  object-fit: cover;
  height: 250px;
  width: 100%;
}
.card-body {
  padding: 20px;
}
.card-text {
  font-size: 16px;
  font-weight: bold;
  font-style: italic;
  margin-bottom: 10px;
}

/* PAYMENT CARD */
.payment-card {
  padding: 1.25rem;
  border: 1px solid #ddd;
  border-radius: 10px;
  background-color: #f8f9fa;
}
.payment-card label {
  font-weight: 600;
  font-style: italic;
}
.payment-card input {
  width: 100%;
  padding: 14px;
  margin-top: 4px;
  margin-bottom: 15px;
  border: 1px solid #ccc;
  border-radius: 5px;
  font-style: italic;
  font-size: 16px;
}
.payment-card button {
  background-color: #28a745;
  border: none;
  color: white;
  padding: 14px 0;
  width: 100%;
  border-radius: 5px;
  font-weight: bold;
  font-style: italic;
  font-size: 16px;
  transition: background-color 0.3s ease;
}
.payment-card button:hover {
  background-color: #218838;
}

/* REVIEW FORM STARS */
.rating-stars {
  display: flex;
  flex-direction: row-reverse;
  justify-content: flex-end;
}
.rating-stars input {
  display: none;
}
.rating-stars label {
  font-size: 32px;
  color: #ccc;
  cursor: pointer;
  transition: color 0.2s;
}
.rating-stars input:checked ~ label,
.rating-stars label:hover,
.rating-stars label:hover ~ label {
  color: #FFD700;
}
@media (max-width: 576px) {
  .rating-stars {
    justify-content: center;
  }
  .rating-stars label {
    font-size: 28px;
  }
}

/* READ-ONLY STARS */
.stars-readonly {
  font-size: 24px;
  color: #FFD700;
}

/* TEXTAREA */
textarea {
  resize: none;
  font-size: 17px;
  padding: 14px;
  width: 100%;
  border-radius: 10px;
  border: 1px solid #bbb;
  font-style: italic;
  box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);
}

/* BUTTONS */
.edit-btn, .btn-dark {
  font-size: 14px;
  padding: 10px 20px;
  border-radius: 5px;
  transition: background-color 0.3s ease;
}
.edit-btn:hover, .btn-dark:hover {
  background-color: #6c757d;
  color: #fff;
}
.review-card form button {
  background: transparent;
  border: none;
  color: #dc3545;
  font-size: 20px;
  padding: 0;
  float: right;
  transition: color 0.2s ease;
}
.review-card form button:hover {
  color: #a71d2a;
}

/* REVIEW CARD */
.review-card {
  border: 1px solid #ddd;
  border-radius: 10px;
  margin-bottom: 15px;
}
.card-title {
  font-size: 18px;
  font-weight: 500;
}
#reach-us .card {
  border-radius: 10px;
  background-color: #fefefe;
}
#reach-us h5 {
  font-weight: bold;
}
.slide-to-pay-container {
  width: 100%;
  max-width: 250px;
  height: 45px;
  background: #fbeaea;
  border-radius: 30px;
  position: relative;
  overflow: hidden;
  margin: 1rem auto;
  user-select: none;
  border: 1px solid #e74c3c;
  transition: background 0.3s ease;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.slide-to-pay-container.success {
  background-color: #d4edda;
  border-color: #28a745;
}

.slider-text {
  position: absolute;
  width: 100%;
  height: 100%;
  line-height: 45px;
  text-align: center;
  color: #721c24;
  font-weight: 600;
  font-style: italic;
  z-index: 0;
  pointer-events: none;
  font-size: 15px;
  transition: color 0.3s;
}

.slide-to-pay-container.success .slider-text {
  color: #155724;
}

.slider-button {
  position: absolute;
  height: 45px;
  width: 45px;
  background: #e74c3c;
  border-radius: 50%;
  top: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 18px;
  cursor: pointer;
  z-index: 1;
  transition: background 0.3s, left 0.3s ease;
}

.slide-to-pay-container.success .slider-button {
  background: #28a745;
}


</style>

<div class="container">

  <!-- Title -->
  <section>
    <div class="row">
      <div class="col-12">
        <h3 class="section-header"><%= listing1.title %></h3>
      </div>
    </div>
  </section>

  <!-- Listing & Booking -->
  <section id="details-booking">
    <div class="details-booking-container">
      <div class="card listing-card">
        <img src="<%= listing1.image.url %>" class="card-img-top show-img" alt="Listing Image">
        <div class="card-body">
          <p class="card-text">Owned by <%= listing1.owner.username %></p>
          <p class="card-text"><%= listing1.description %></p>
          <p class="card-text">Price: ₹ <%= listing1.price.toLocaleString("en-IN") %></p>
          <p class="card-text">
  Location: <strong><%= listing1.formattedAddress || (listing1.location + ', ' + listing1.country) %></strong>
</p>

          <p class="card-text">Category: <%= listing1.category %></p>
        </div>
      </div>

      <div class="payment-card">
        <h5 class="section-header">Book This Stay</h5>
        <% if (currUser) { %>
          <form action="/payment/create-checkout-session" method="POST" id="paymentForm">
            <label for="checkInDate">Check-in Date</label>
            <input type="date" id="checkInDate" name="checkInDate" required min="<%= new Date().toISOString().split('T')[0] %>">

            <label for="stayDays">Number of Days</label>
            <input type="number" id="stayDays" name="stayDays" min="1" value="1" required>

            <p><strong>Total Price: ₹ <span id="totalPrice"><%= listing1.price.toLocaleString("en-IN") %></span></strong></p>

            <input type="hidden" name="amount" id="amount" value="<%= listing1.price %>">
            <input type="hidden" name="listingId" value="<%= listing1._id %>">

            <div class="slide-to-pay-container">
                <div class="slider-text">Slide to Pay</div>
                <div class="slider-button" id="sliderBtn"><span>→</span></div>
            </div>

          </form>
        <% } else { %>
          <div class="alert alert-warning" role="alert">
            Please <a href="/login" class="alert-link">log in</a> to proceed with payment.
          </div>
        <% } %>
      </div>
    </div>

    <% if (currUser && listing1.owner._id.equals(currUser._id)) { %>
      <div class="row justify-content-center">
        <div class="col-md-8 d-flex justify-content-between">
          <a href="/listings/<%= listing1._id %>/edit" class="btn btn-dark edit-btn">Edit</a>
          <form method="post" action="/listings/<%= listing1._id %>?_method=DELETE">
            <button class="btn btn-dark">Delete</button>
          </form>
        </div>
      </div>
    <% } %>
  </section>

  <!-- Reviews -->
  <section id="reviews">
    <div class="row">
      <div class="col text-center">
        <h4 class="section-header">Reviews</h4>
      </div>
    </div>

    <% if (currUser) { %>
      <div class="row justify-content-center">
        <div class="col-md-8">
          <form action="/listings/<%= listing1.id %>/reviews" method="post">
            <div class="mb-3">
              <label class="form-label">Rating</label>
              <div class="rating-stars">
                <% for (let i = 5; i >= 1; i--) { %>
                  <input type="radio" id="star<%= i %>" name="review[rating]" value="<%= i %>">
                  <label for="star<%= i %>">★</label>
                <% } %>
              </div>
            </div>
            <div class="mb-3">
              <label for="comment" class="form-label">Comment</label>
              <textarea name="review[comment]" id="comment" rows="5" placeholder="Write your honest thoughts... ❤️" required></textarea>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
          </form>
        </div>
      </div>
    <% } %>

    <div class="row justify-content-center mt-4">
      <% for (review of listing1.reviews) { %>
        <div class="card col-md-5 ms-3 mb-3 review-card">
          <div class="card-body">
            <form action="/listings/<%= listing1._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
              <button title="Delete review" aria-label="Delete review">🗑️</button>
            </form>
            <h5 class="card-title">@<%= review.author.username %></h5>
            <p class="stars-readonly">
              <% for (let i = 1; i <= 5; i++) { %>
                <%= i <= review.rating ? '★' : '☆' %>
              <% } %>
            </p>
            <p class="card-text"><%= review.comment %></p>
          </div>
        </div>
      <% } %>
    </div>
  </section>
</div>
<!-- Reach Us Section -->
<section id="reach-us" class="mt-5">
  <div class="row">
    <div class="col text-center">
      <h4 class="section-header">📍 Reach Us</h4>
    </div>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-10">
      <div class="card p-4 mb-4 shadow-sm">
        <h5 class="mb-3"><i class="bi bi-geo-alt-fill"></i> Full Address</h5>
        <p><%= listing1.formattedAddress || (listing1.location + ", " + listing1.country) %></p>

        <!-- Optional: Add pincode if you store it -->
        <% if (listing1.pincode) { %>
          <p><strong>Pincode:</strong> <%= listing1.pincode %></p>
        <% } %>

        <!-- Map -->
        <div id="map" style="height: 300px; border-radius: 10px; margin-top: 1rem;"></div>
      </div>
    </div>
  </div>
</section>

<!-- Leaflet Map Scripts -->
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<script>
  document.addEventListener("DOMContentLoaded", async () => {
    const address = "<%= listing1.formattedAddress.replace(/"/g, '\\"') %>";
    const map = L.map('map').setView([20.5937, 78.9629], 5); // Center on India initially

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    try {
      const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}`, {
        headers: {
          'User-Agent': 'WanderlustApp'
        }
      });
      const data = await response.json();
      if (data.length > 0) {
        const { lat, lon } = data[0];
        map.setView([lat, lon], 14);
        L.marker([lat, lon]).addTo(map).bindPopup(address).openPopup();
      }
    } catch (err) {
      console.error("Error loading map:", err);
    }
  });
</script>


<script>
document.addEventListener('DOMContentLoaded', () => {
  const pricePerDay = <%- JSON.stringify(listing1.price) %>;
  const stayDaysInput = document.getElementById('stayDays');
  const totalPriceSpan = document.getElementById('totalPrice');
  const amountInput = document.getElementById('amount');

  function updateTotalPrice() {
    let days = parseInt(stayDaysInput.value, 10);
    if (isNaN(days) || days < 1) days = 1;
    const total = pricePerDay * days;
    totalPriceSpan.textContent = total.toLocaleString('en-IN');
    if (amountInput) amountInput.value = total;
  }

  stayDaysInput.addEventListener('input', updateTotalPrice);
  updateTotalPrice();
});
</script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const pricePerDay = <%- JSON.stringify(listing1.price) %>;
  const stayDaysInput = document.getElementById('stayDays');
  const checkInDateInput = document.getElementById('checkInDate');
  const totalPriceSpan = document.getElementById('totalPrice');
  const amountInput = document.getElementById('amount');
  const sliderBtn = document.getElementById("sliderBtn");
  const slideContainer = document.querySelector(".slide-to-pay-container");
  const form = document.getElementById("paymentForm");

  // Create warning div
  const warningDiv = document.createElement("div");
  warningDiv.style.color = "#c0392b";
  warningDiv.style.fontWeight = "bold";
  warningDiv.style.marginTop = "10px";
  warningDiv.style.display = "none";
  warningDiv.textContent = "⚠️ Please fill all fields before sliding.";
  slideContainer.parentNode.insertBefore(warningDiv, slideContainer.nextSibling);

  function validateForm() {
    const dateValid = checkInDateInput.value.trim() !== "";
    const daysValid = stayDaysInput.value && parseInt(stayDaysInput.value) >= 1;
    return dateValid && daysValid;
  }

  function updateTotalPrice() {
    const days = parseInt(stayDaysInput.value) || 1;
    const total = pricePerDay * days;
    totalPriceSpan.textContent = total.toLocaleString('en-IN');
    amountInput.value = total;
  }

  stayDaysInput.addEventListener('input', updateTotalPrice);
  checkInDateInput.addEventListener('change', updateTotalPrice);
  updateTotalPrice();

  let isSliding = false;

  sliderBtn.addEventListener("mousedown", (e) => {
    if (!validateForm()) {
      warningDiv.style.display = "block";
      return;
    }

    warningDiv.style.display = "none";
    isSliding = true;

    const rect = slideContainer.getBoundingClientRect();
    const maxSlide = rect.width - sliderBtn.offsetWidth;

    document.onmousemove = (e) => {
      if (!isSliding) return;

      let offsetX = e.clientX - rect.left - sliderBtn.offsetWidth / 2;
      offsetX = Math.max(0, Math.min(offsetX, maxSlide));
      sliderBtn.style.left = `${offsetX}px`;

      if (offsetX >= maxSlide) {
        isSliding = false;
        sliderBtn.innerHTML = "✔️";
        slideContainer.classList.add("success");

        document.onmousemove = null;
        document.onmouseup = null;

        setTimeout(() => form.submit(), 500);
      }
    };

    document.onmouseup = () => {
      if (isSliding) {
        isSliding = false;
        sliderBtn.style.left = "0px";
      }
      document.onmousemove = null;
      document.onmouseup = null;
    };
  });
});
</script>

